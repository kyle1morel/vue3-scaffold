{
  "name": "vue3-scaffold-frontend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "",
  "author": "Kyle Morel",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "vite build",
    "build:dts": "vue-tsc --declaration --emitDeclarationOnly",
    "clean": "rimraf coverage dist",
    "debug": "vite --mode debug",
    "format": "prettier ./src --write",
    "format:tests": "node ./format-test-blank-lines.mjs",
    "lint": "eslint && npm run lint:i18n",
    "lint:fix": "eslint --fix",
    "lint:i18n": "node ./check-i18n-keys.mjs",
    "preview": "vite preview",
    "prebuild": "npm run lint",
    "prelint": "npm run typecheck",
    "prelint:fix": "npm run typecheck",
    "pretest": "npm run lint",
    "posttest": "node ./lcov-fix.mjs",
    "purge": "rimraf node_modules",
    "rebuild": "npm run clean && npm run build",
    "reinstall": "npm run purge && npm install",
    "dev": "vite",
    "test": "vitest run --coverage",
    "test:dev": "vitest",
    "test:shuffle": "vitest run --sequence.shuffle",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@bcgov/bc-sans": "2.1.1",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@primeuix/themes": "2.0.2",
    "axios": "1.20.0",
    "date-fns": "4.4.0",
    "oidc-client-ts": "3.5.0",
    "pinia": "3.0.4",
    "pinia-plugin-persistedstate": "4.7.1",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "quill": "2.0.3",
    "tailwindcss-primeui": "0.6.1",
    "vee-validate": "4.15.1",
    "vue": "^3.5.41",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@pinia/testing": "1.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/vue": "8.1.0",
    "@tsconfig/node26": "26.0.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "axe-core": "4.14.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "happy-dom": "20.12.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "sass": "1.103.1",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "allowScripts": {
    "@parcel/watcher": false
  }
}
