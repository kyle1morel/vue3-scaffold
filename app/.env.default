# .env.default

# Generic defaults only; copy to .env and override as needed. Real environment variables always win.
# DO NOT SAVE environment-specific settings or secrets in this file.

FRONTEND_APIPATH=api/v1 # Client base API path
# FRONTEND_NOTIFICATION_BANNER= # Optional banner message shown in the frontend
# FRONTEND_OIDC_AUTHORITY= # OIDC authority used by the frontend
# FRONTEND_OIDC_CLIENTID= # OIDC client ID used by the frontend

SERVER_APIPATH=/v1 # Server API path mounted under /api
SERVER_BODYLIMIT=30mb # Maximum request body size
SERVER_DB_DATABASE=vue3scaffold # PostgreSQL database name
SERVER_DB_HOST=localhost # PostgreSQL host
# SERVER_DB_PASSWORD= # PostgreSQL password
SERVER_DB_POOL_MAX=10 # Maximum connections in the pool
SERVER_DB_POOL_MIN=2 # Minimum connections in the pool
SERVER_DB_PORT=5432 # PostgreSQL port
SERVER_DB_USERNAME=app # PostgreSQL username
# SERVER_ENV= # Deployment environment (dev, test, prod); selects config/features-<env>.json
SERVER_LOGLEVEL=info # Log level (fatal, error, warn, info, debug, trace or silent)
# SERVER_LOGSINGLELINE=true # Constrains pretty (non-production) logging to a single line per event
# SERVER_OIDC_AUDIENCE= # Expected audience of OIDC JWT tokens
# SERVER_OIDC_AUTHORITY= # Issuer of OIDC JWT tokens
SERVER_PORT=8080 # Port for the application server
