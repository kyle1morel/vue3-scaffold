{
  "name": "vue3-scaffold-app",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Vue3 Scaffold",
  "author": "Kyle Morel",
  "engines": {
    "node": ">=24"
  },
  "main": "server.ts",
  "type": "module",
  "imports": {
    "#types": "./src/types/index.ts",
    "#prismaClient": "./src/db/generated/client/client.ts",
    "#prismaZod": "./src/db/generated/zod/schemas/index.ts",
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts"
  },
  "scripts": {
    "build:all": "node ./deploy-utils.ts",
    "clean:all": "node ./deploy-utils.ts clean",
    "clean": "rimraf coverage dist",
    "docs:types": "node ./src/docs/generateTypes.ts",
    "format": "prettier . --write",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "migrate:down": "node ./migrate.ts down",
    "migrate:latest": "node ./migrate.ts latest",
    "migrate:list": "node ./migrate.ts list",
    "migrate:make": "node ./migrate.ts make",
    "migrate:rollback": "node ./migrate.ts rollback",
    "migrate:up": "node ./migrate.ts up",
    "postclean:all": "npm run clean",
    "postinstall": "npm run prisma:generate",
    "postmigrate:down": "npm run prisma:sync",
    "postmigrate:latest": "npm run prisma:sync",
    "postmigrate:up": "npm run prisma:sync",
    "postprisma:case": "npm run prisma:generate",
    "postprisma:sync": "npm run prisma:case",
    "posttest": "node ./lcov-fix.ts",
    "prelint": "npm run typecheck",
    "prelint:fix": "npm run typecheck",
    "pretest": "npm run lint",
    "prisma:case": "prisma-case-format -f \"./src/db/prisma/schema.prisma\" --table-case=snake --field-case=camel --enum-case=snake",
    "prisma:generate": "prisma generate",
    "prisma:sync": "prisma db pull",
    "purge": "rimraf node_modules",
    "reinstall": "npm run purge && npm install",
    "dev": "node --watch --watch-preserve-output --env-file-if-exists=.env ./server.ts",
    "start": "node ./server.ts",
    "test": "vitest run --coverage",
    "test:dev": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "js-yaml": "5.4.1",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "4.1.0",
    "kysely": "0.29.7",
    "lru-cache": "11.5.2",
    "pg": "8.23.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prisma/generator-helper": "7.10.0",
    "@tsconfig/node24": "24.0.5",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.9.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-prettier": "5.5.6",
    "openapi-typescript": "7.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "prisma-case-format": "2.2.1",
    "prisma-zod-generator": "3.3.1",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "vitest-mock-extended": "5.1.1"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@prisma/engines@4.16.2": false
  }
}
